{
  "phase": "Execute preparation",
  "pi_executable": "/opt/homebrew/bin/pi",
  "pi_package": "@earendil-works/pi-coding-agent",
  "pi_version": "1.3.0",
  "provider": "openai-codex",
  "model": "gpt-6-sol",
  "thinking": "medium",
  "tools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "flags": [
    "--print",
    "--mode",
    "json",
    "--no-context-files",
    "--no-skills",
    "--no-extensions",
    "--no-mcp"
  ],
  "skill_injection": "--append-system-prompt <one full skill snapshot>",
  "stdin": "DEVNULL",
  "turn_timeout_seconds": 900,
  "auth_and_model_call": "unverified until case execution",
  "runtime_settings": "same host pi configuration; explicit CLI settings above override per run",
  "credential_contents_recorded": false,
  "cases": {
    "s1": [
      "baseline",
      "revised"
    ],
    "s2": [
      "revised",
      "baseline"
    ],
    "s3": [
      "baseline",
      "revised"
    ]
  },
  "comparisons": 6,
  "turns_per_conversation": 2
}
